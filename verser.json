{
  "version": 2,
  "name": "al-basirah",
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/",              "dest": "/index.html" },
    { "src": "/savants",       "dest": "/savants.html" },
    { "src": "/savant",        "dest": "/savant.html" },
    { "src": "/bibliotheque",  "dest": "/bibliotheque.html" },
    { "src": "/live",          "dest": "/live.html" },
    { "src": "/categories",    "dest": "/categories.html" },
    { "src": "/connexion",     "dest": "/connexion.html" },
    { "src": "/inscription",   "dest": "/inscription.html" },
    { "src": "/(.*)",          "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
